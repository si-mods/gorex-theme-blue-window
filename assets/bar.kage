package main

// Blue Window title bar: a glossy XP-style blue, lighter in the upper half
// and deeper in the lower, with a light line along the top. Every tone is
// at least as deep as Top, so the white text keeps 4.5:1 when Top is the
// accent.

// The tone at the top, and the flat color of the title bar.
//gorex:param color seed:accent
var Top vec3

// The deepest tone, at the bottom.
//gorex:param color #144d99
var Bottom vec3

func Fragment(dst vec4, pos vec2) vec4 {
	h := rectSize().y
	y := pos.y / h
	c := mix(Top, mix(Top, Bottom, 0.35), clamp(y/0.45, 0, 1))
	if y > 0.45 {
		c = mix(mix(Top, Bottom, 0.7), Bottom, clamp((y-0.45)/0.55, 0, 1))
	}
	if pos.y < 1 {
		c = vec3(0.55, 0.78, 0.96)
	} else if pos.y < 2 {
		c = vec3(0.30, 0.58, 0.88)
	}
	if h-pos.y < 1 {
		c = vec3(0.05, 0.22, 0.47)
	}
	return vec4(c, 1)
}
