package main

// Blue Window background: a bright sky, soft clouds, a few sparkles and a
// small robot in the lower right of the window. All shapes are distance
// fields; no images.

var Time float
var Origin, Window vec2

func sdRBox(p, b vec2, r float) float {
	q := abs(p) - b + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

func sdSeg(p, a, b vec2, r float) float {
	pa := p - a
	ba := b - a
	h := clamp(dot(pa, ba)/dot(ba, ba), 0, 1)
	return length(pa-ba*h) - r
}

func fill(d float) float {
	return clamp(0.5-d, 0, 1)
}

// cloud is the coverage of a puffy cloud at c, w wide.
func cloud(p, c vec2, w float) float {
	q := (p - c) / w
	d := sdRBox(q-vec2(0, 0.12), vec2(0.5, 0.12), 0.12)
	d = min(d, length(q-vec2(-0.22, 0.02))-0.2)
	d = min(d, length(q-vec2(0.05, -0.08))-0.27)
	d = min(d, length(q-vec2(0.3, 0.04))-0.18)
	return clamp(-d*w/14+0.35, 0, 1)
}

// sparkle is a four-point star of radius r at c.
func sparkle(p, c vec2, r float) float {
	q := abs(p-c) / r
	s := clamp(1-(q.x*q.y*10+q.x+q.y)*0.8, 0, 1)
	g := clamp(1-length(q)*2.2, 0, 1) * 0.35
	return max(s*s, g)
}

func Fragment(dst vec4, pos vec2) vec4 {
	wp := pos + Origin
	uv := wp / Window
	// The sky: deep at the top, pale at the bottom.
	sky := mix(vec3(0.42, 0.71, 0.93), vec3(0.75, 0.88, 0.98), clamp(uv.y*1.4, 0, 1))
	sky = mix(sky, vec3(0.92, 0.965, 1.0), clamp((uv.y-0.55)*1.6, 0, 1))
	// A soft diagonal sheen, as on a glossy desktop.
	sh := sin((uv.x*0.8-uv.y)*7.0) * 0.5 + 0.5
	sky += vec3(0.03, 0.03, 0.02) * sh * sh * sh
	col := sky

	// Clouds, drifting slowly, in the upper part of the window.
	if uv.y < 0.75 {
		drift := Time * 4
		cl := cloud(wp, vec2(mod(Window.x*0.18+drift, Window.x+300)-150, Window.y*0.2), 260)
		cl = max(cl, cloud(wp, vec2(mod(Window.x*0.62+drift*0.7, Window.x+360)-180, Window.y*0.11), 340))
		cl = max(cl, cloud(wp, vec2(mod(Window.x*0.4+drift*0.5, Window.x+300)-150, Window.y*0.52), 220))
		cl = max(cl, cloud(wp, vec2(mod(Window.x*0.9+drift*0.6, Window.x+300)-150, Window.y*0.42), 200))
		col = mix(col, vec3(1, 1, 1), cl*0.85)
	}

	// Sparkles that twinkle.
	sp := 0.0
	for i := 0; i < 5; i++ {
		f := float(i)
		c := vec2(fract(f*0.618+0.09), fract(f*0.382+0.13)) * Window
		tw := 0.55 + 0.45*sin(Time*1.7+f*2.4)
		sp = max(sp, sparkle(wp, c, 16+10*fract(f*0.37))*tw)
	}
	col = mix(col, vec3(1, 1, 1), sp)

	// The robot, in the lower right, 1 DIP a unit.
	p := wp - (Window - vec2(160, 150))
	if abs(p.x) < 110 && abs(p.y) < 125 {
		bob := sin(Time*2) * 2
		p.y -= bob
		wave := sin(Time*3) * 0.25
		// shadow on the ground
		gs := length((p-vec2(0, 96-bob))/vec2(58, 9))
		col = mix(col, vec3(0.25, 0.45, 0.7), clamp(1-gs, 0, 1)*0.25)
		// parts
		head := sdRBox(p-vec2(0, -34), vec2(50, 40), 26)
		ears := min(length(p-vec2(-54, -34))-12, length(p-vec2(54, -34))-12)
		ant := sdSeg(p, vec2(0, -74), vec2(0, -90), 3)
		ball := length(p-vec2(0, -95)) - 8
		body := sdRBox(p-vec2(0, 42), vec2(34, 30), 16)
		armL := sdSeg(p, vec2(-34, 32), vec2(-52, 60), 8)
		hand := vec2(64, -6+wave*20)
		armR := sdSeg(p, vec2(34, 30), hand, 8)
		feet := min(sdRBox(p-vec2(-17, 78), vec2(14, 8), 7), sdRBox(p-vec2(17, 78), vec2(14, 8), 7))
		all := min(min(min(head, ears), min(ant, ball)), min(min(body, armL), min(armR, feet)))
		all = min(all, length(p-hand)-11)
		col = mix(col, vec3(0.09, 0.27, 0.52), fill(all-2.5))
		shade := clamp(0.5+p.y/240, 0, 1)
		white := mix(vec3(1, 1, 1), vec3(0.78, 0.88, 0.97), shade)
		blue := mix(vec3(0.45, 0.73, 0.95), vec3(0.16, 0.46, 0.78), shade)
		col = mix(col, blue, fill(min(min(ears, feet), min(armL, min(armR, length(p-hand)-11)))))
		col = mix(col, blue, fill(ant))
		col = mix(col, vec3(0.95, 0.72, 0.21), fill(ball))
		col = mix(col, white, fill(body))
		col = mix(col, white, fill(head))
		// gloss on the head
		gl := length((p-vec2(-22, -60))/vec2(20, 9))
		col = mix(col, vec3(1, 1, 1), clamp(1-gl, 0, 1)*0.8)
		// the face screen and its eyes
		scr := sdRBox(p-vec2(0, -30), vec2(36, 24), 14)
		col = mix(col, vec3(0.09, 0.23, 0.38), fill(scr))
		ey := vec2(abs(p.x)-15, p.y+32)
		eye := sdSeg(vec2(ey.x, ey.y), vec2(-6, 4), vec2(0, -3), 2.6)
		eye = min(eye, sdSeg(vec2(ey.x, ey.y), vec2(0, -3), vec2(6, 4), 2.6))
		col = mix(col, vec3(0.5, 0.9, 1.0), fill(eye))
		sm := abs(length(p-vec2(0, -24))-7) - 2
		if p.y > -22 {
			col = mix(col, vec3(0.5, 0.9, 1.0), fill(sm))
		}
		// a badge on the chest
		badge := length(p-vec2(0, 42)) - 11
		col = mix(col, vec3(0.16, 0.46, 0.78), fill(badge))
		col = mix(col, vec3(0.95, 0.72, 0.21), fill(length(p-vec2(0, 42))-4))
	}
	return vec4(col, 1)
}
