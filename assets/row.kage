package main

// Blue Window chosen row: a light blue gradient, a 1 px border with a white
// line inside it, and a blue accent bar at the left edge.

// The tone at the top.
//gorex:param color #e0f1ff
var Top vec3

// The tone at the bottom.
//gorex:param color #c2def7
var Bottom vec3

// The 1 px border.
//gorex:param color #73b3ed
var Border vec3

// The accent bar, at its bottom.
//gorex:param color seed:accent
var Accent vec3

// The accent bar, at its top.
//gorex:param color #4d9ce0
var AccentTop vec3

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	y := pos.y / s.y
	c := mix(Top, Bottom, y)
	e := min(min(pos.x, s.x-pos.x), min(pos.y, s.y-pos.y))
	if e < 2 {
		c = vec3(0.98, 0.99, 1.0)
	}
	if e < 1 {
		c = Border
	}
	if pos.x < 3 {
		c = mix(AccentTop, Accent, y)
	}
	return vec4(c, 1)
}
